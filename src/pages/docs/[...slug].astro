---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsShell from "../../components/docs/DocsShell.astro";
import { getDocNeighbours, sortDocs } from "../../lib/docs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<"docs">;
};

const { entry } = Astro.props as Props;
const docs = sortDocs(await getCollection("docs"));
const { Content } = await render(entry);
const { previous, next } = getDocNeighbours(docs, entry.id);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <DocsShell entries={docs} currentId={entry.id}>
    <article class="max-w-[74ch]">
      <p class="font-mono text-[0.875rem] leading-5 text-graphite">{entry.data.section}</p>
      <h1 class="mt-3 text-[clamp(2.25rem,4vw,3.25rem)] font-semibold leading-[1.02] tracking-[-0.05em]">
        {entry.data.title}
      </h1>
      <p class="lede mt-5">{entry.data.description}</p>

      <div class="docs-prose mt-10">
        <Content />
      </div>
    </article>

    <nav aria-label="Documentation pagination" class="mt-14 grid gap-4 border-t border-rule pt-6 sm:grid-cols-2">
      {
        previous ? (
          <a href={`/docs/${previous.id}`} class="group block max-w-[34ch] no-underline">
            <span class="font-mono text-[0.875rem] leading-4 text-graphite">Previous</span>
            <span class="mt-1 block text-[0.9375rem] font-medium text-ink group-hover:underline">
              {previous.data.title}
            </span>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a href={`/docs/${next.id}`} class="group block max-w-[34ch] no-underline sm:justify-self-end sm:text-right">
            <span class="font-mono text-[0.875rem] leading-4 text-graphite">Next</span>
            <span class="mt-1 block text-[0.9375rem] font-medium text-ink group-hover:underline">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>
  </DocsShell>
</BaseLayout>
