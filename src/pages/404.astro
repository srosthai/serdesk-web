---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
---

<BaseLayout
  title="Not found"
  description="The page you requested does not exist."
  noindex
>
  <Container>
    <div class="section-space">
      <p class="font-mono text-[0.6875rem] leading-5 text-graphite">404</p>
      <h1 class="page-title mt-3 max-w-[16ch]">This route does not exist.</h1>
      <p class="lede mt-5">
        The page may have moved, or the link may be incomplete. Start from the product overview or
        open the documentation.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="button button-primary">Back to home</a>
        <a href="/docs" class="button button-secondary">Read the documentation</a>
      </div>
    </div>
  </Container>
</BaseLayout>
