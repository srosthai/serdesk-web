---
import Container from "../layout/Container.astro";
import { formatBytes, formatReleaseDate, type Release } from "../../data/releases";
import { site } from "../../data/site";

interface Props {
  release: Release | null;
}

const { release } = Astro.props;
---

{
  release ? (
    <section class="border-y border-rule">
      <Container class="py-10 md:py-14">
        <div class="flex flex-col gap-6 border-b border-rule pb-8 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="font-mono text-[0.6875rem] leading-5 text-graphite">Current release</p>
            <h2 class="mt-2 text-[2rem] font-semibold tracking-[-0.045em]">{release.version}</h2>
            <p class="mt-1 text-[0.875rem] text-graphite">
              Released <time datetime={release.releaseDate}>{formatReleaseDate(release.releaseDate)}</time>
            </p>
          </div>
          <div class="flex flex-wrap gap-4 text-[0.875rem] font-medium">
            <a href={release.notesUrl} class="text-link">Release notes</a>
            <a href={release.docsUrl} class="text-link">Installation guide</a>
          </div>
        </div>

        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[720px] border-collapse text-left text-[0.8125rem]">
            <thead>
              <tr class="border-b border-rule font-mono text-[0.625rem] leading-4 text-graphite">
                <th class="py-3 pr-4 font-medium">Platform</th>
                <th class="py-3 pr-4 font-medium">Format</th>
                <th class="py-3 pr-4 font-medium">Architecture</th>
                <th class="py-3 pr-4 font-medium">Size</th>
                <th class="py-3 pr-4 font-medium">SHA-256</th>
                <th class="py-3 font-medium">Installer</th>
              </tr>
            </thead>
            <tbody>
              {release.assets.map((asset) => (
                <tr class="border-b border-rule align-top">
                  <td class="py-4 pr-4">{asset.platform}</td>
                  <td class="py-4 pr-4">{asset.format}</td>
                  <td class="py-4 pr-4">{asset.architecture}</td>
                  <td class="py-4 pr-4">{formatBytes(asset.sizeBytes)}</td>
                  <td class="py-4 pr-4">
                    {asset.sha256 ? (
                      <code class="break-all font-mono text-[0.6875rem] leading-5">{asset.sha256}</code>
                    ) : (
                      <span class="text-graphite">Not provided</span>
                    )}
                  </td>
                  <td class="py-4">
                    <a href={asset.url} class="text-link font-medium">
                      Download {asset.fileName}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Container>
    </section>
  ) : (
    <section class="border-y border-rule bg-mist">
      <Container class="py-10 md:py-14">
        <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
          <div>
            <p class="font-mono text-[0.6875rem] leading-5 text-graphite">Current release</p>
            <h2 class="mt-2 text-[1.75rem] font-semibold tracking-[-0.04em]">
              No public installers yet.
            </h2>
            <p class="mt-2 max-w-[58ch] text-[0.9375rem] leading-7 text-graphite">
              Installers, checksums, and release notes will appear here when a build is published.
              The GitHub Releases page is the source of truth in the meantime.
            </p>
          </div>
          <a
            href={site.releases}
            target="_blank"
            rel="noreferrer"
            class="button button-secondary justify-self-start md:justify-self-end"
          >
            Open GitHub Releases
          </a>
        </div>
      </Container>
    </section>
  )
}
