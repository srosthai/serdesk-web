---
import type { Feature } from "../../data/features";
import type { ProductScreenshot } from "../../data/screenshots";
import Container from "../layout/Container.astro";

interface Props {
  title: string;
  description: string;
  features: Feature[];
  image: ProductScreenshot;
  reverse?: boolean;
}

const { title, description, features, image, reverse = false } = Astro.props;
---

<section class="section-space border-b border-rule">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:items-start lg:gap-16">
      <div class:list={["min-w-0", reverse ? "lg:order-2" : ""]}>
        <h2 class="section-title">{title}</h2>
        <p class="lede mt-5">{description}</p>

        <dl class="mt-8 border-t border-rule md:mt-10">
          {
            features.map((feature) => (
              <div class="border-b border-rule py-5">
                <dt class="text-[1rem] font-medium tracking-[-0.015em]">{feature.name}</dt>
                <dd class="mt-2 max-w-[54ch] text-[0.9375rem] leading-7 text-graphite">
                  {feature.detail}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class:list={["min-w-0", reverse ? "lg:order-1" : ""]}>
        <div class="overflow-hidden rounded-[16px] border border-rule bg-mist p-1.5">
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
            class="aspect-[16/10] w-full rounded-[11px] object-cover"
          />
        </div>
        <figcaption
          class="mt-3 flex items-center justify-between gap-4 font-mono text-[0.6875rem] leading-5 text-graphite"
        >
          <span>{image.view}</span>
          <span>Actual app view</span>
        </figcaption>
      </figure>
    </div>
  </Container>
</section>
