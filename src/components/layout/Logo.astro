---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a
  href="/"
  aria-label="ServerDesk home"
  class:list={["inline-flex items-center gap-2.5 text-ink no-underline", className]}
>
  <img
    src="/logo-mark.png"
    alt=""
    width="160"
    height="160"
    class="size-6 shrink-0 rounded-[6px] object-cover ring-1 ring-black/10"
    decoding="async"
  />
  <span class="text-[0.9375rem] font-semibold tracking-[-0.02em]">ServerDesk</span>
</a>
