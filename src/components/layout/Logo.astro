---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a
  href="/"
  aria-label="ServerPilot home"
  class:list={["inline-flex items-center gap-2.5 text-ink no-underline", className]}
>
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="24" height="24" rx="6" fill="currentColor"></rect>
    <path d="M7 8.25H17" stroke="white" stroke-width="1.5" stroke-linecap="round"></path>
    <path d="M7 12H14.5" stroke="white" stroke-width="1.5" stroke-linecap="round"></path>
    <path d="M7 15.75H11.5" stroke="white" stroke-width="1.5" stroke-linecap="round"></path>
    <circle cx="17" cy="15.75" r="1.25" fill="white"></circle>
  </svg>
  <span class="text-[0.9375rem] font-semibold tracking-[-0.02em]">ServerPilot</span>
</a>
