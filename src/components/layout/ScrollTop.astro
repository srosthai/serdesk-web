---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  data-scroll-top
  aria-label="Back to top"
  class="scroll-top fixed right-5 bottom-5 z-40 inline-flex size-11 items-center justify-center rounded-full border border-rule bg-paper/95 text-ink shadow-[0_10px_34px_rgba(17,17,17,0.12)] backdrop-blur-sm hover:bg-mist focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:right-8 md:bottom-8"
>
  <Icon name="ph:arrow-up" class="size-4" aria-hidden="true" />
</button>
