---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import { footerColumns, legalLinks, site } from "../../data/site";
---

<footer class="border-t border-rule bg-paper">
  <div class="container-page py-14 md:py-18">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_repeat(3,1fr)] lg:gap-10">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-5 max-w-[34ch] text-[0.9375rem] leading-7 text-graphite">
          A local-first desktop workspace for Linux VPS servers. Direct SSH, no hosted account, no
          agent on the server.
        </p>
        <a
          href={site.github}
          target="_blank"
          rel="noreferrer"
          class="mt-6 inline-flex items-center gap-1.5 text-[0.875rem] font-medium text-ink no-underline hover:text-graphite"
        >
          View the project on GitHub
          <Icon name="ph:arrow-up-right" class="size-3.5" aria-hidden="true" />
        </a>
      </div>

      {
        footerColumns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="footer-heading">{column.heading}</h2>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link inline-flex items-center gap-1.5"
                    target={"external" in link && link.external ? "_blank" : undefined}
                    rel={"external" in link && link.external ? "noreferrer" : undefined}
                  >
                    {link.label}
                    {"external" in link && link.external ? (
                      <Icon name="ph:arrow-up-right" class="size-3 text-graphite" aria-hidden="true" />
                    ) : null}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-rule pt-6 text-[0.75rem] text-graphite sm:flex-row sm:items-center sm:justify-between md:mt-18"
    >
      <p>© 2026 ServerDesk. Free to use.</p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="no-underline hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
