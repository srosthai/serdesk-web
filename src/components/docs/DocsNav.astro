---
import type { DocEntry } from "../../lib/docs";
import { groupDocs } from "../../lib/docs";

interface Props {
  entries: DocEntry[];
  currentId?: string;
  class?: string;
}

const { entries, currentId, class: className = "" } = Astro.props;
const groups = groupDocs(entries);
---

<nav aria-label="Documentation" class:list={["text-[0.875rem]", className]}>
  <a
    href="/docs"
    class:list={[
      "block border-b border-rule pb-3 font-medium text-ink no-underline",
      currentId === "index" ? "text-ink" : "",
    ]}
  >
    Documentation
  </a>

  {
    groups.map((group) => (
      <div class="mt-6 first:mt-5">
        <p class="font-mono text-[0.875rem] leading-4 text-graphite">{group.section}</p>
        <ul class="mt-2 space-y-1">
          {group.entries.map((entry) => (
            <li>
              <a
                href={`/docs/${entry.id}`}
                aria-current={entry.id === currentId ? "page" : undefined}
                class:list={[
                  "block border-l py-1.5 pl-3 no-underline transition-colors",
                  entry.id === currentId
                    ? "border-ink text-ink"
                    : "border-transparent text-graphite hover:border-rule hover:text-ink",
                ]}
              >
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
