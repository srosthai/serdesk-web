---
import { Icon } from "astro-icon/components";
import type { ProductScreenshot } from "../../data/screenshots";

interface Props {
  image: ProductScreenshot;
  caption?: string;
  frame?: "mist" | "paper";
  class?: string;
}

const { image, caption = image.view, frame = "mist", class: className = "" } = Astro.props;
const dialogId = `screenshot-${image.id}`;
const titleId = `${dialogId}-title`;
---

<figure class:list={["min-w-0", className]} data-reveal>
  <div
    class:list={[
      "group overflow-hidden rounded-[16px] border border-rule p-1.5",
      frame === "paper" ? "bg-paper" : "bg-mist",
    ]}
  >
    <button
      type="button"
      data-screenshot-open={dialogId}
      aria-haspopup="dialog"
      aria-label={`Open larger ${image.view} screenshot`}
      class="block w-full cursor-zoom-in overflow-hidden rounded-[11px]"
    >
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full rounded-[11px] object-cover transition-transform duration-500 ease-out group-hover:scale-[1.01]"
      />
    </button>
  </div>

  <figcaption
    class="mt-3 flex items-center justify-between gap-4 font-mono text-[0.875rem] leading-5 text-graphite"
  >
    <span>{caption}</span>
    <button
      type="button"
      data-screenshot-open={dialogId}
      aria-haspopup="dialog"
      class="inline-flex items-center gap-1.5 text-right text-graphite underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
    >
      Actual app view
      <Icon name="ph:arrows-out" class="size-3.5" aria-hidden="true" />
    </button>
  </figcaption>
</figure>

<dialog
  id={dialogId}
  data-screenshot-dialog
  aria-labelledby={titleId}
  class="m-auto w-[min(96vw,1400px)] overflow-hidden rounded-[16px] border border-band-foreground/15 bg-band p-2 text-band-foreground"
>
  <div class="flex items-center justify-between gap-4 px-2 py-2">
    <p id={titleId} class="font-mono text-[0.875rem] text-band-foreground/70">{image.view}</p>
    <button
      type="button"
      data-screenshot-close
      aria-label="Close larger screenshot"
      class="inline-flex size-10 items-center justify-center rounded-[10px] border border-band-foreground/25 text-band-foreground transition-colors hover:bg-band-foreground/10"
    >
      <Icon name="ph:x" class="size-5" aria-hidden="true" />
    </button>
  </div>
  <img
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    class="max-h-[80dvh] w-full rounded-[10px] object-contain"
  />
</dialog>
