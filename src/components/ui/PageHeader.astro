---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = "" } = Astro.props;
---

<header class:list={["border-b border-rule pb-10 pt-16 md:pb-14 md:pt-24", className]}>
  <h1 class="page-title">{title}</h1>
  {
    description ? (
      <p class="lede mt-5 max-w-[58ch] text-[1.0625rem] md:mt-6 md:text-[1.1875rem]">{description}</p>
    ) : null
  }
  <slot />
</header>
