---
import { Icon } from "astro-icon/components";
import Container from "../layout/Container.astro";
import Threads from "../reactbits/Threads";
import { heroScreenshot } from "../../data/screenshots";
import { site } from "../../data/site";
---

<section class="relative isolate flex min-h-[calc(100dvh-4rem)] items-center overflow-hidden border-b border-rule">
  <div
    aria-hidden="true"
    class="absolute inset-y-0 right-0 z-0 h-full w-full opacity-40 lg:hidden [mask-image:linear-gradient(to_right,transparent_0%,black_38%,black_100%)]"
  >
    <div class="hero-dot-field h-full w-full"></div>
  </div>

  <div
    aria-hidden="true"
    class="hero-threads absolute inset-y-0 right-0 z-0 hidden w-[68%] opacity-70 lg:block [mask-image:linear-gradient(to_right,transparent_0%,black_38%,black_100%)]"
  >
    <Threads
      client:media="(min-width: 1024px)"
      className="h-full w-full"
      color="#111111"
      accentColor="#111111"
      amplitude={1.35}
      distance={0.35}
      enableMouseInteraction
      lineCount={58}
      thickness={0.5}
      softness={1.1}
      speed={0.28}
      waves={1.1}
      split={0.05}
      fray={0.55}
      angle={18}
      seed={7}
      parting={0.45}
      taper={0.9}
      brightness={1.15}
      fade={0.16}
      opacity={0.22}
    />
  </div>

  <Container class="relative z-10 pb-12 pt-12 md:pb-16 md:pt-16 lg:pb-20 lg:pt-20">
    <h1 class="display-title max-w-[1120px]">
      <span class="block">Your servers.</span>{" "}
      <span class="block">One desktop. Full control.</span>
    </h1>

    <div
      class="mt-10 grid gap-10 lg:mt-12 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-start lg:gap-12"
    >
      <div class="max-w-[46ch]">
        <p class="lede">
          Manage your VPS servers from one desktop application. Connect through SSH, monitor
          resources, manage services, browse files, and work with your servers from one place.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/download" class="button button-primary">Download ServerDesk</a>
          <a href="/features" class="button button-secondary">Explore features</a>
        </div>

        <p class="mono-note mt-7 max-w-[38ch] text-graphite">
          Free to use for Windows, macOS, and Linux. No cloud account required.
        </p>
      </div>

      <figure class="min-w-0">
        <div class="overflow-hidden rounded-[16px] border border-rule bg-mist p-1.5">
          <button
            type="button"
            data-hero-lightbox-open
            aria-haspopup="dialog"
            aria-label="Open larger application screenshot"
            class="block w-full cursor-zoom-in overflow-hidden rounded-[11px]"
          >
            <img
              src={heroScreenshot.src}
              alt={heroScreenshot.alt}
              width={heroScreenshot.width}
              height={heroScreenshot.height}
              class="aspect-[16/10] w-full rounded-[11px] object-cover transition-transform duration-500 ease-out hover:scale-[1.01]"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </button>
        </div>
        <figcaption
          class="mt-3 flex items-center justify-between gap-4 font-mono text-[0.875rem] leading-5 text-graphite"
        >
          <span>Server inventory</span>
          <button
            type="button"
            data-hero-lightbox-open
            aria-haspopup="dialog"
            class="inline-flex items-center gap-1.5 text-right text-graphite underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
          >
            Actual app view
            <Icon name="ph:arrows-out" class="size-3.5" aria-hidden="true" />
          </button>
        </figcaption>
      </figure>
    </div>

    <p class="sr-only">{site.description}</p>
  </Container>
</section>


<dialog
  data-hero-lightbox
  aria-labelledby="hero-lightbox-title"
  class="m-auto w-[min(96vw,1400px)] overflow-hidden rounded-[16px] border border-band-foreground/15 bg-band p-2 text-band-foreground"
>
  <div class="flex items-center justify-between gap-4 px-2 py-2">
    <p id="hero-lightbox-title" class="font-mono text-[0.875rem] text-band-foreground/70">
      Server inventory
    </p>
    <button
      type="button"
      data-hero-lightbox-close
      aria-label="Close larger screenshot"
      class="inline-flex size-10 items-center justify-center rounded-[10px] border border-band-foreground/25 text-band-foreground transition-colors hover:bg-band-foreground/10"
    >
      <Icon name="ph:x" class="size-5" aria-hidden="true" />
    </button>
  </div>
  <img
    src={heroScreenshot.src}
    alt={heroScreenshot.alt}
    width={heroScreenshot.width}
    height={heroScreenshot.height}
    class="max-h-[80dvh] w-full rounded-[10px] object-contain"
  />
</dialog>

<style>
  dialog::backdrop {
    background: rgba(5, 5, 5, 0.9);
    backdrop-filter: blur(4px);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-hero-lightbox]");
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-hero-lightbox-open]");
  const close = document.querySelector<HTMLButtonElement>("[data-hero-lightbox-close]");

  if (dialog) {
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        dialog.showModal();
        document.body.style.overflow = "hidden";
      });
    });

    close?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
