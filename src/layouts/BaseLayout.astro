---
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import ScrollTop from "../components/layout/ScrollTop.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/og-image.png",
  noindex = false,
} = Astro.props;

const fullTitle = title === "ServerDesk" ? title : `${title} · ServerDesk`;
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content="ServerDesk" />
    <meta name="author" content="ServerDesk" />
    <meta property="og:locale" content="en_US" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ServerDesk" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ServerDesk, a local-first desktop workspace for VPS servers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="ServerDesk, a local-first desktop workspace for VPS servers" />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? "#0b0b0b" : "#ffffff");
      })();
    </script>
    <noscript>
      <style>
        [data-theme-toggle],
        [data-scroll-top] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div data-nav-sentinel aria-hidden="true" class="h-px w-full"></div>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <div data-scroll-sentinel aria-hidden="true" class="h-px w-full"></div>
    <Footer />
    <ScrollTop />

    <script is:inline>
      (() => {
        const items = Array.from(document.querySelectorAll("[data-reveal]"));
        if (items.length === 0) return;

        const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
        if (reduce || !("IntersectionObserver" in window)) {
          items.forEach((item) => item.classList.add("is-visible"));
          return;
        }

        document.documentElement.classList.add("reveal-ready");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );

        items.forEach((item) => observer.observe(item));
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggles = Array.from(document.querySelectorAll("[data-theme-toggle]"));
        const meta = document.querySelector('meta[name="theme-color"]');

        const applyTheme = (dark) => {
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
          if (meta) meta.setAttribute("content", dark ? "#0b0b0b" : "#ffffff");
          toggles.forEach((toggle) => {
            toggle.setAttribute("aria-pressed", String(dark));
            toggle.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
          });
        };

        applyTheme(root.classList.contains("dark"));

        toggles.forEach((toggle) => {
          toggle.addEventListener("click", () => {
            const dark = !root.classList.contains("dark");
            applyTheme(dark);
            localStorage.setItem("theme", dark ? "dark" : "light");
          });
        });

        const media = window.matchMedia("(prefers-color-scheme: dark)");
        media.addEventListener?.("change", (event) => {
          if (!localStorage.getItem("theme")) applyTheme(event.matches);
        });

        const top = document.querySelector("[data-scroll-top]");
        const sentinel = document.querySelector("[data-scroll-sentinel]");

        if (top) {
          top.addEventListener("click", () => {
            const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
          });

          if (sentinel && "IntersectionObserver" in window) {
            new IntersectionObserver(
              ([entry]) => top.classList.toggle("is-visible", entry.isIntersecting),
              { threshold: 0 },
            ).observe(sentinel);
          } else {
            top.classList.add("is-visible");
          }
        }
      })();
    </script>
  </body>
</html>
